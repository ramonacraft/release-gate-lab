# Release Gate Lab — default is no secrets.
# Leave everything commented out for local UI work.
# Real tokens belong only in Azure Pipeline secrets / Vercel project env — never commit them.

# Vercel deploy (Azure pipeline)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Live Recent runs API (set in Vercel project settings)
# AZURE_DEVOPS_ORG=
# AZURE_DEVOPS_PROJECT=
# AZURE_DEVOPS_PAT=
# AZURE_PIPELINE_DEFINITION_ID=

# PR comment gate (Azure pipeline secret)
# GITHUB_TOKEN=

# See docs/AZURE_VERCEL_SETUP.md and docs/PHASE4_AND_DEMOS.md
